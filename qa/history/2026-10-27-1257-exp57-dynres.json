{
 "version": 1,
 "id": "25-shape-shifter-2",
 "note": "#57 native 4K: where are the slow frames, and is the dynres blit clean (no stale edges, no shift) right after a resolution step?",
 "params": {
  "res": "native"
 },
 "resolutions": [
  "4k"
 ],
 "warmup": 0.5,
 "seconds": 24,
 "record": {
  "stills": 1
 },
 "values": {
  "render": "__qa.render",
  "canvas": "__qa.canvas"
 },
 "gates": [
  {
   "metric": "longFrames",
   "max": 0.25,
   "name": "native 4K: ≤ 3 frames over 20 ms in ~1400 (0.25 %)"
  },
  {
   "metric": "errors",
   "max": 0
  },
  {
   "metric": "gpuBusy",
   "max": 10
  }
 ],
 "debug": {
  "frameTimes": true,
  "qaDump": {
   "every": 0.1,
   "read": {
    "frame": "window.__probe && __probe.frame",
    "render": "__qa.render",
    "canvas": "__qa.canvas",
    "bars": "__qa.bars"
   }
  },
  "screenshotAtFrame": [
   36,
   42,
   48,
   54,
   60,
   66,
   72,
   78,
   84,
   90,
   96,
   104,
   112,
   980,
   1000,
   1020,
   1040,
   1060,
   1080,
   1100
  ],
  "console": true
 },
 "checks": [
  "check-25"
 ],
 "timeoutMin": 40
}