{
  "version": 1,
  "id": "13-flow-lab",
  "note": "13 rocks (#58): obstacles with real shapes (rounded 3/5/7-gons, noise blobs), inflow 1.4x, vorticity 8, vermilion/cyan dye swapping every bar. vortex runs too, to show the disc obstacles and the Strouhal lock are unchanged.",
  "resolutions": ["1080p", "4k"],
  "warmup": 6,
  "seconds": 12,
  "variants": [
    { "name": "rocks", "params": { "preset": "rocks" } },
    { "name": "vortex", "params": { "preset": "vortex" } }
  ],
  "gates": [
    { "metric": "fps.p05", "min": 55 },
    { "metric": "longFrames", "max": 0.5 },
    { "metric": "errors", "max": 0 },
    { "metric": "gpuBusy", "max": 10 },
    { "metric": "clip", "max": 2, "variant": "rocks" },
    { "metric": "lum.mean", "min": 0, "name": "brightness, reported (rocks vs base in the swipe)" }
  ],
  "checks": ["check-13"],
  "record": { "stills": 2 },
  "swipe": { "vs": "base", "seconds": 40, "warmup": 4, "variants": ["rocks"] },
  "debug": { "console": true, "screenshotAt": [2, 8] }
}
