{
  "version": 1,
  "id": "24-paint-pour",
  "note": "24 Paint Pour (#87): exact marbling (drops, tine combs, vortices) traced per pixel, thick-paint shading, tiled bakes; first page on clock.js. 120 BPM, 16-bar sections: bar 0 drop, 8-11 breakdown, 12-15 build (pour). startBar puts each window on its event (warmup 4 s = 2 bars).",
  "resolutions": ["1080p", "4k"],
  "warmup": 4,
  "seconds": 12,
  "variants": [
    { "name": "default", "params": {} },
    { "name": "flat", "params": { "qa": "flat", "veinColour": "none" } },
    { "name": "drop", "params": { "startBar": "13" } },
    { "name": "build", "params": { "startBar": "9" } },
    { "name": "breakdown", "params": { "startBar": "5" } },
    { "name": "bake", "params": { "opsMax": "32", "startBar": "1" } },
    { "name": "psych60s", "params": { "palette": "psych60s", "veinColour": "yellow" } }
  ],
  "values": {
    "truths": "__qa.check().ok",
    "t1": "__qa.check().t1.ok",
    "t1comb": "__qa.check().t1.comb",
    "t1vortex": "__qa.check().t1.vortex",
    "t1drop": "__qa.check().t1.drop",
    "t3": "__qa.check().t3.ok",
    "t3maxErr": "__qa.check().t3.maxErr",
    "t3hitMismatch": "__qa.check().t3.hitMismatch",
    "t3ops": "__qa.check().t3.ops",
    "t4": "__qa.check().t4.ok",
    "t5": "String(__qa.check().t5.ok)",
    "t5relErr": "__qa.check().t5.relErr ?? -1",
    "t9": "String(__qa.check().t9.ok)",
    "t9diff": "__qa.check().t9.diff ?? -1",
    "t9detail": "JSON.stringify({ onlyLogged: __qa.check().t9.onlyLogged, onlyReplay: __qa.check().t9.onlyReplay, backSteps: __qa.check().t9.backSteps, epochs: __qa.check().t9.epochs })",
    "t3maxErrAll": "__qa.check().t3.maxErrAll",
    "bakeOps": "__qa.bakes.map(b => b.ops).join(',')",
    "worstSync": "(o => o ? JSON.stringify({ tBeat: o.tBeat, role: o.role, cause: o.cause, syncMs: Math.round(o.syncMs * 10) / 10, queuedMs: Math.round(o.queuedMs), frame: o.frame, baking: o.baking }) : 'none')(__qa.opLog.reduce((w, o) => (!w || Math.abs(o.syncMs) > Math.abs(w.syncMs) ? o : w), null))",
    "clockAheadMaxMs": "Math.round(__qa.clockSmooth.maxAhead * 60000 / __qa.bpm)",
    "lateOps": "__qa.opLog.filter(o => Math.abs(o.syncMs) > 40).length",
    "t10": "__qa.check().t10.ok",
    "contrastMin": "__qa.check().t10.min",
    "ops": "__qa.view.live",
    "opsLogged": "__qa.opLog.length",
    "syncMaxMs": "__qa.opLog.length ? Math.max(...__qa.opLog.map(o => Math.abs(o.syncMs))) : 999",
    "drops": "__qa.opLog.filter(o => o.role === 'drop').length",
    "pours": "__qa.opLog.filter(o => o.role === 'pour').length",
    "breakdownDrops": "__qa.opLog.filter(o => o.role === 'drop' && ((Math.floor(o.tBeat / 4) % 16) + 16) % 16 >= 8 && ((Math.floor(o.tBeat / 4) % 16) + 16) % 16 < 12).length",
    "combs": "__qa.opLog.filter(o => o.role === 'comb' || o.role === 'feather').length",
    "bakes": "__qa.bakes.length",
    "bakeMs": "__qa.bakes.length ? Math.max(...__qa.bakes.map(b => b.ms)) : 0",
    "events": "__qa.events().length",
    "clockPlaying": "__qa.clock.playing",
    "forceDrop": "typeof __qa.forceDrop"
  },
  "gates": [
    { "metric": "value.t1", "equals": true, "variant": "default", "name": "truth 1: every op is area-preserving, max |det J - 1| < 1e-5 (float64)" },
    { "metric": "value.t3", "equals": true, "name": "truth 3: the shader's trace matches the float64 trace (max error < 1e-4, same drop away from boundaries)" },
    { "metric": "value.t4", "equals": true, "variant": "default", "name": "truth 4: a stroke then the same stroke reversed is the identity (< 1e-6)" },
    { "metric": "value.t5", "equals": "true", "variant": "build", "name": "truth 5: the pour law r = sqrt(rate t / pi), within 0.5 %" },
    { "metric": "value.t9", "equals": "true", "name": "truth 9: the op log replays from the seed and the beat clock alone" },
    { "metric": "value.t10", "equals": true, "variant": "default", "name": "truth 10: canada colours >= 3:1 against the ground, no big drop above L 0.75" },
    { "metric": "value.syncMaxMs", "max": 40, "name": "truth 8: every op goes live within 40 ms of its beat" },
    { "metric": "value.clockPlaying", "equals": true, "name": "the shared clock is playing (Play pressed)" },
    { "metric": "value.drops", "min": 1, "variant": "drop", "name": "the drop at bar 16 fired" },
    { "metric": "value.pours", "min": 1, "variant": "build", "name": "the build's pour started at bar 12" },
    { "metric": "value.breakdownDrops", "max": 0, "name": "no big drops in the breakdown (bars 8-11)" },
    { "metric": "value.combs", "min": 1, "variant": ["default", "breakdown"], "name": "combs on the kick (groove) and feathers (breakdown)" },
    { "metric": "value.bakes", "min": 1, "variant": "bake", "name": "opsMax 32: at least one tiled bake in the window" },
    { "metric": "value.forceDrop", "equals": "function", "name": "#88 forceDrop hook" },
    { "metric": "fps.p05", "min": 55 },
    { "metric": "longFrames", "max": 0.5 },
    { "metric": "errors", "max": 0 },
    { "metric": "gpuBusy", "max": 10 },
    { "metric": "clip", "max": 1, "name": "no white blobs: <= 1 % pixels clipped" }
  ],
  "record": { "stills": 2 },
  "debug": { "console": true }
}
