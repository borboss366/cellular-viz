{
  "version": 1,
  "id": "15-traveller",
  "note": "15a the traveller (#37 comment 6493121591): 2-opt on the beat, drop snap to the Hilbert SFC tour then 2-opt to a crossing-free local optimum, ant colony (rho 0.1), heat, Held-Karp verify for n <= 13. CPU truths also run under node (qa/runner/test/tsp15a.test.mjs). 120 BPM, 16-bar sections, drop at bar 8.",
  "resolutions": ["1080p", "4k"],
  "warmup": 4,
  "seconds": 12,
  "variants": [
    { "name": "settled", "params": { "build": "0" } },
    { "name": "build", "params": {} },
    { "name": "ants", "params": { "build": "0", "macro3": "1" } },
    { "name": "small-verify", "params": { "build": "0", "macro1": "0" } },
    { "name": "big", "params": { "build": "0", "macro1": "1", "macro2": "1" } }
  ],
  "values": {
    "hamiltonian": "__qa.check().hamiltonian",
    "crossings": "__qa.check().crossings",
    "settled": "__qa.check().settled",
    "truth1Ok": "__qa.truth1().ok || __qa.truth1().moves === 0",
    "truth1Bad": "__qa.truth1().bad",
    "routeCountOk": "__qa.check().routeCountOk",
    "heldKarpOk": "__qa.check().heldKarpOk",
    "antDecayBad": "__qa.ants.bad",
    "antIters": "__qa.ants.iter",
    "n": "__qa.state.n",
    "hkOptimal": "__qa.heldKarp ? __qa.heldKarp.optimal : null",
    "hkGap": "__qa.heldKarp ? __qa.heldKarp.gap : null",
    "metrics": "__qa.metrics"
  },
  "gates": [
    { "metric": "value.hamiltonian", "equals": true, "name": "QA 3: the tour is a Hamiltonian cycle" },
    { "metric": "value.truth1Bad", "max": 0, "name": "QA 1: with heat 0 no move raises the length" },
    { "metric": "value.crossings", "max": 0, "variant": ["settled", "small-verify", "big"], "name": "QA 2: a settled 2-opt tour has no crossings" },
    { "metric": "value.routeCountOk", "equals": true, "name": "QA 4: (n-1)!/2 = 181440 at 10, 60822550204416000 at 20" },
    { "metric": "value.antDecayBad", "max": 0, "variant": ["ants"], "name": "QA 5: an edge no ant used decays by exactly (1-rho)" },
    { "metric": "value.antIters", "min": 4, "variant": ["ants"], "name": "QA 5: ant iterations ran (one per beat)" },
    { "metric": "value.heldKarpOk", "equals": true, "name": "QA 6: Held-Karp = brute force (n 5-9, in the page)" },
    { "metric": "fps.p05", "min": 55 },
    { "metric": "longFrames", "max": 0.5 },
    { "metric": "errors", "max": 0 },
    { "metric": "gpuBusy", "max": 10 },
    { "metric": "clip", "max": 1, "name": "no white blobs: <= 1 % pixels clipped" }
  ],
  "record": { "stills": 2 },
  "swipe": { "seconds": 40, "warmup": 4, "variants": ["build", "ants"] },
  "debug": { "console": true, "screenshotAt": [2, 8] }
}
