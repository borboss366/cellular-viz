{
  "version": 1,
  "id": "29-neon-tunnel",
  "note": "#330 29 Neon Tunnel, part 1: first run anywhere. Stills centred, hard left, the top corner and mid turn (?qaTarget, eased under the comfort caps); both ends of each knob (beat g0/g3, speed half/two rings a beat, turn 0/1, colour 0/1); no-beat mode. Gates on the caps (turn speed, roll, view widening), one ring a beat at each speed, the kick light's cap. Shared rows for the default URL, g3 and two rings a beat.",
  "params": { "labels": "0" },
  "resolutions": ["1080p"],
  "warmup": 4,
  "seconds": 8,
  "variants": [
    { "name": "g1", "params": {} },
    { "name": "centre", "params": { "qaTarget": "0,0" } },
    { "name": "left", "params": { "qaTarget": "-1,0" } },
    { "name": "corner", "params": { "qaTarget": "0.85,0.75" } },
    { "name": "midturn", "params": { "qaTarget": "1,-0.6", "qaTargetAt": 10.5 } },
    { "name": "g0", "params": { "beatGain": 0 } },
    { "name": "g3", "params": { "beatGain": 3 } },
    { "name": "s0", "params": { "speed": 0 } },
    { "name": "s1", "params": { "speed": 1 } },
    { "name": "t0", "params": { "turn": 0 } },
    { "name": "t1", "params": { "turn": 1 } },
    { "name": "c0", "params": { "colour": 0 } },
    { "name": "c1", "params": { "colour": 1 } },
    { "name": "nobeat", "params": { "qaConfidence": 0 } }
  ],
  "shared": { "variants": ["g3", "s1"] },
  "values": {
    "g": "__qa.beat ? __qa.beat.g : -1",
    "kick": "__qa.beat ? __qa.beat.kick : -1",
    "kickNow": "__qa.beat ? __qa.beat.now : -1",
    "rate": "__qa.tunnel ? __qa.tunnel.rate : -1",
    "ringsPerBeat": "__qa.tunnel && __qa.tunnel.ringsPerBeat !== null ? __qa.tunnel.ringsPerBeat : -1",
    "maxTurn": "__qa.tunnel ? __qa.tunnel.maxTurn : -1",
    "maxRollDeg": "__qa.tunnel ? __qa.tunnel.maxRollDeg : -1",
    "maxWidenRate": "__qa.tunnel ? __qa.tunnel.maxWidenRate : -1",
    "w": "__qa.tunnel ? __qa.tunnel.w : -1",
    "kicks": "__qa.tunnel ? __qa.tunnel.kicksStarted : -1",
    "fromEnergy": "__qa.tunnel ? __qa.tunnel.kicksFromEnergy : -1",
    "targetX": "__qa.tunnel && __qa.tunnel.target ? __qa.tunnel.target.x : -9",
    "targetY": "__qa.tunnel && __qa.tunnel.target ? __qa.tunnel.target.y : -9",
    "farOff": "__qa.tunnel && __qa.tunnel.target ? Math.hypot(__qa.tunnel.farEnd.x - __qa.tunnel.target.x, __qa.tunnel.farEnd.y - __qa.tunnel.target.y) : -1",
    "floatTargets": "__qa.view ? (__qa.view.floatTargets ? 1 : 0) : -1"
  },
  "gates": [
    { "metric": "errors", "max": 0 },
    { "metric": "value.g", "equals": 0, "variant": "g0", "name": "?beatGain=0: g 0" },
    { "metric": "value.g", "equals": 3, "variant": "g3", "name": "?beatGain=3: g 3" },
    { "metric": "value.g", "equals": 1, "variant": ["g1", "centre", "left", "corner", "midturn", "s0", "s1", "t0", "t1", "c0", "c1", "nobeat"], "name": "no knob: g 1" },
    { "metric": "value.kick", "max": 0, "variant": "g0", "name": "g 0: no kick light" },
    { "metric": "value.kickNow", "max": 0, "variant": "g0", "name": "g 0: no kick light drawn" },
    { "metric": "value.kick", "min": 0.899, "max": 0.901, "variant": "g1", "name": "g 1: kick light 0.9 (as designed)" },
    { "metric": "value.kick", "max": 1.8, "name": "the kick light never over its cap 1.8" },
    { "metric": "value.kickNow", "max": 1.8, "name": "the kick light drawn never over 1.8" },
    { "metric": "value.kicks", "min": 8, "variant": ["g0", "g1", "g3", "s0", "s1"], "name": "the clock's kicks reach the scene" },
    { "metric": "value.rate", "equals": 0.5, "variant": "s0", "name": "speed knob 0: half a ring a beat" },
    { "metric": "value.rate", "equals": 1, "variant": "g1", "name": "speed knob middle: one ring a beat" },
    { "metric": "value.rate", "equals": 2, "variant": "s1", "name": "speed knob 1: two rings a beat" },
    { "metric": "value.ringsPerBeat", "min": 0.42, "max": 0.58, "variant": "s0", "name": "half a ring passes a beat (counted)" },
    { "metric": "value.ringsPerBeat", "min": 0.9, "max": 1.1, "variant": "g1", "name": "one ring passes a beat (counted)" },
    { "metric": "value.ringsPerBeat", "min": 1.85, "max": 2.15, "variant": "s1", "name": "two rings pass a beat (counted)" },
    { "metric": "value.maxTurn", "max": 0.3501, "name": "comfort: the target never moves faster than 0.35 a second" },
    { "metric": "value.maxRollDeg", "max": 15.001, "name": "comfort: the roll never past 15 degrees" },
    { "metric": "value.maxWidenRate", "max": 0.0601, "name": "comfort: the view never widens faster than 6 % a second" },
    { "metric": "value.farOff", "max": 0.001, "name": "the far end sits on the target" },
    { "metric": "value.targetX", "min": -0.02, "max": 0.02, "variant": ["centre", "t0"], "name": "centred: x" },
    { "metric": "value.targetY", "min": -0.02, "max": 0.02, "variant": ["centre", "t0"], "name": "centred: y" },
    { "metric": "value.targetX", "max": -0.95, "variant": "left", "name": "hard left reached under the caps" },
    { "metric": "value.targetX", "min": 0.8, "variant": "corner", "name": "the top corner reached: x" },
    { "metric": "value.targetY", "min": 0.7, "variant": "corner", "name": "the top corner reached: y" },
    { "metric": "value.targetX", "min": 0.05, "max": 0.95, "variant": "midturn", "name": "mid turn: on the way to the corner", "report": true },
    { "metric": "value.w", "max": 0.05, "variant": "nobeat", "name": "?qaConfidence=0: no-beat mode (beat weight 0)" },
    { "metric": "value.fromEnergy", "min": 1, "variant": "nobeat", "name": "no-beat: the heard kick lights the rings", "report": true },
    { "metric": "value.floatTargets", "equals": 1, "name": "float render targets (else 8 bits, dithered)", "report": true },
    { "metric": "clip", "max": 1, "name": "at most 1 % clipped pixels" },
    { "metric": "lum.mean", "max": 25, "name": "dark, never empty (mean luminance, % of white)", "report": true },
    { "metric": "fps.p05", "min": 55, "variant": "g1", "name": "holds 60 fps alone at 1080p (the slot-B pairing is not measurable here)", "report": true }
  ],
  "record": { "stills": 2 },
  "debug": { "console": true }
}
