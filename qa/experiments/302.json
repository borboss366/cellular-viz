{
  "version": 1,
  "id": "16-hodge-kaleidoscope",
  "note": "#302 16b Hodge stronger top (Sunday fix list, 22 Nov: \"100 is not enough\"): stills at beat gain 0, 1 (the middle, unchanged) and 3 (the knob's top: swell 0.40, pop 0.50, breath 0.30, kick glow 1.6); flash rows for the default URL (g 1) and g3",
  "params": { "labels": "0" },
  "resolutions": ["1080p"],
  "warmup": 4,
  "seconds": 8,
  "variants": [
    { "name": "g0", "params": { "beatGain": 0 } },
    { "name": "g1", "params": {} },
    { "name": "g3", "params": { "beatGain": 3 } }
  ],
  "shared": { "variants": ["g3"] },
  "values": { "tableOk": "__qa.check().tableOk", "symmetric": "__qa.check().symmetric", "g": "__qa.beat ? __qa.beat.g : -1", "glow": "__qa.beat ? __qa.beat.glow : -1", "kickSize": "__qa.beat ? __qa.beat.kickSize : -1", "breath": "__qa.beat ? __qa.beat.breath : -1", "hueG": "__qa.beat ? __qa.beat.hueG : -1" },
  "gates": [
    { "metric": "errors", "max": 0 },
    { "metric": "value.tableOk", "equals": true, "name": "truths hold: the Hodge table" },
    { "metric": "value.symmetric", "equals": true, "name": "truths hold: Hodge and Serre symmetry" },
    { "metric": "value.g", "equals": 0, "variant": "g0", "name": "?beatGain=0: g 0" },
    { "metric": "value.g", "equals": 1, "variant": "g1", "name": "no knob: g 1 (the middle)" },
    { "metric": "value.g", "equals": 3, "variant": "g3", "name": "?beatGain=3: g 3" },
    { "metric": "value.glow", "max": 0, "variant": "g0", "name": "g 0: no kick glow" },
    { "metric": "value.breath", "equals": 0.08, "variant": "g1", "name": "g 1: breath 0.08 (the middle unchanged)" },
    { "metric": "value.glow", "max": 1, "variant": "g1", "name": "g 1: the kick glow at most +1.0 (the middle unchanged)" },
    { "metric": "value.breath", "min": 0.29, "max": 0.31, "variant": "g3", "name": "g 3: breath 0.30 (was 0.24)" },
    { "metric": "value.glow", "max": 1.6, "name": "the kick glow never over +1.6" },
    { "metric": "value.kickSize", "max": 0.4, "name": "the kick swell never over +0.40" }
  ],
  "record": { "stills": 2 },
  "debug": { "console": true }
}
