{
  "version": 1,
  "id": "24-paint-pour",
  "note": "#284 24 beat strength: stills at beat gain 0 (no beat reaction), 1 (today) and 3 (the knob's top), as the set plays it (beatFx 0) with the colour pulse at 0.6 so it shows",
  "params": { "beatFx": "0", "pulse": "0.6" },
  "resolutions": ["1080p"],
  "warmup": 4,
  "seconds": 8,
  "variants": [
    { "name": "g0", "params": { "beatGain": 0 } },
    { "name": "g1", "params": {} },
    { "name": "g3", "params": { "beatGain": 3 } }
  ],
  "values": { "g": "__qa.beat ? __qa.beat.g : -1", "kick": "__qa.beat ? __qa.beat.kick : -1", "pulse": "__qa.beat ? __qa.beat.pulse : -1" },
  "gates": [
    { "metric": "errors", "max": 0 },
    { "metric": "value.g", "equals": 0, "variant": "g0", "name": "?beatGain=0: g 0" },
    { "metric": "value.g", "equals": 1, "variant": "g1", "name": "no knob: g 1 (as today)" },
    { "metric": "value.g", "equals": 3, "variant": "g3", "name": "?beatGain=3: g 3" },
    { "metric": "value.pulse", "max": 0, "variant": "g0", "name": "g 0: no colour pulse" },
    { "metric": "value.kick", "max": 0, "variant": "g0", "name": "g 0: no kick gloss" },
    { "metric": "value.pulse", "max": 3, "name": "the pulse never over 3 (+24 % brightness)" },
    { "metric": "value.kick", "max": 3, "name": "the kick gloss never over +0.3" }
  ],
  "record": { "stills": 2 },
  "debug": { "console": true }
}
