{
  "version": 1,
  "id": "16-hodge-kaleidoscope",
  "note": "#289 knob pick-up: Hodge loaded as in slot B after Paint Pour (the clock's stored dive knob at 1.0 and glint knob at 1.0, ?qaClockKnobs): the dive stays at depth 0 and the glints off until the knob moves. Stills at beat gain 0, 1 (today) and 3",
  "params": { "labels": "0", "diveKnob": "2", "glintKnob": "3", "qaClockKnobs": "2:1,3:1" },
  "resolutions": ["1080p"],
  "warmup": 4,
  "seconds": 8,
  "variants": [
    { "name": "g0", "params": { "beatGain": 0 } },
    { "name": "g1", "params": {} },
    { "name": "g3", "params": { "beatGain": 3 } }
  ],
  "values": { "tableOk": "__qa.check().tableOk", "depth": "__qa.dive ? __qa.dive.depth : -1", "zoom": "__qa.dive ? __qa.dive.zoom : -1", "glint": "__qa.dive ? __qa.dive.glint : -1", "bursts": "__qa.dive ? __qa.dive.bursts.length : -1", "g": "__qa.beat ? __qa.beat.g : -1" },
  "gates": [
    { "metric": "errors", "max": 0 },
    { "metric": "value.tableOk", "equals": true, "name": "truths hold: the Hodge table" },
    { "metric": "value.depth", "max": 0.001, "name": "the stored dive knob (1.0) is ignored on arrival: depth 0" },
    { "metric": "value.depth", "min": 0, "name": "the dive state is there" },
    { "metric": "value.zoom", "min": 0.999, "name": "zoom x1 (no x12 dive)" },
    { "metric": "value.glint", "max": 0, "name": "the stored glint knob is ignored on arrival" },
    { "metric": "value.bursts", "max": 0, "name": "no burst" },
    { "metric": "value.g", "equals": 0, "variant": "g0", "name": "?beatGain=0: g 0" },
    { "metric": "value.g", "equals": 1, "variant": "g1", "name": "no knob: g 1" },
    { "metric": "value.g", "equals": 3, "variant": "g3", "name": "?beatGain=3: g 3" }
  ],
  "record": { "stills": 2 },
  "debug": { "console": true }
}
