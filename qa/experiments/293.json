{
  "version": 1,
  "id": "24-paint-pour",
  "note": "#293 24 Paint Pour on a tilted plane (knob 3 / 7, the camera follows the flow): stills at tilt 0, 20, 35 (the page default), 45 for the user's pick of the set angle; TT1 (t0 = main), TT2 (speed grows with sin), TT3 (h^2 law), TK1 (knob 0 / 1), TK2 + TK3 (a 0 -> 1 -> 0 sweep over 4 s: flash, GPU, coverage). As the set plays it: beatFx 0, pulse 1.",
  "params": { "beatFx": "0", "pulse": "1" },
  "resolutions": ["1080p"],
  "warmup": 12,
  "seconds": 8,
  "variants": [
    { "name": "t0", "params": { "tilt": 0 } },
    { "name": "t20", "params": { "tilt": 20 } },
    { "name": "t35", "params": {} },
    { "name": "t45", "params": { "tilt": 45 } },
    { "name": "k0", "params": { "qaTiltKnob": 0 } },
    { "name": "k1", "params": { "qaTiltKnob": 1 } },
    { "name": "sweep", "params": { "qaTiltSweep": 1 } }
  ],
  "shared": { "variants": ["t0", "sweep"] },
  "values": {
    "truths": "__qa.check().ok",
    "t3": "__qa.check().t3.ok",
    "t3maxErr": "__qa.check().t3.maxErr",
    "t9": "String(__qa.check().t9.ok)",
    "t9diff": "__qa.check().t9.diff ?? -1",
    "t10": "__qa.check().t10.ok",
    "syncMaxMs": "__qa.syncLog.length ? Math.max(...__qa.syncLog.map(o => Math.abs(o.syncMs))) : 999",
    "clockPlaying": "__qa.clock.playing",
    "still": "__qa.tilt.still",
    "deg": "__qa.tilt.deg",
    "speedNormMax": "__qa.tilt.speedNormMax",
    "speedMax": "__qa.tilt.speedMax",
    "lawRatio": "__qa.tilt.law.ratio",
    "slewMax": "__qa.tilt.slewMax",
    "darkAvg": "__qa.tilt.darkAvg ?? -1",
    "darkMax": "__qa.tilt.darkMax ?? -1",
    "darkMin": "__qa.tilt.darkMin ?? -1",
    "darkMaxAll": "__qa.tilt.darkMaxAll ?? -1",
    "scrolled": "__qa.tilt.S",
    "feeds": "__qa.tilt.feeds",
    "lifts": "__qa.tilt.lifts",
    "camera": "__qa.tilt.camera",
    "ops": "__qa.view.live",
    "bakes": "__qa.bakes.length"
  },
  "gates": [
    { "metric": "errors", "max": 0 },
    { "metric": "value.clockPlaying", "equals": true, "name": "the shared clock is playing (Play pressed)" },
    { "metric": "value.still", "equals": true, "variant": "t0", "name": "TT1: tilt 0, every shift, the scroll and the base offset exactly 0 (main's picture)" },
    { "metric": "value.speedNormMax", "max": 0, "variant": "t0", "name": "TT1: tilt 0, nothing slides" },
    { "metric": "value.truths", "equals": true, "variant": "t0", "name": "TT1: truths 1, 3, 4, 5, 9, 10 at tilt 0" },
    { "metric": "value.syncMaxMs", "max": 40, "variant": "t0", "name": "TT1: truth 8 at tilt 0, every op within 40 ms of its beat" },
    { "metric": "value.speedNormMax", "min": 0.03, "max": 0.05, "variant": "t20", "name": "TT2: 20 degrees, downhill speed K sin(20-23) = 0.038-0.043 screen heights a second per h^2" },
    { "metric": "value.speedNormMax", "min": 0.05, "max": 0.075, "variant": "t35", "name": "TT2: 35 degrees, K sin(35-38) = 0.063-0.068" },
    { "metric": "value.speedNormMax", "min": 0.07, "variant": "t45", "name": "TT2: 45 degrees, K sin(45-48) = 0.078-0.082, above 20 and 35 (monotone)" },
    { "metric": "value.lawRatio", "min": 2.4, "max": 5.6, "variant": "t45", "name": "TT3: twice the thickness advances 4x as far (+-40 %), on the scene's own step" },
    { "metric": "value.speedNormMax", "max": 0, "variant": "k0", "name": "TK1: knob 0, no downhill speed" },
    { "metric": "value.still", "equals": true, "variant": "k0", "name": "TK1: knob 0, the plane flat (no scroll)" },
    { "metric": "value.speedNormMax", "min": 0.08, "variant": "k1", "name": "TK1: knob 1 (60 degrees), K sin 60 = 0.095, at least 5x knob 0" },
    { "metric": "value.slewMax", "max": 60.5, "variant": "sweep", "name": "TK2: the angle slews at <= 60 degrees a second through the sweep" },
    { "metric": "value.darkAvg", "min": 0.25, "max": 0.6, "variant": "sweep", "name": "TK3: dark coverage averaged over the window 25-60 % through the sweep" },
    { "metric": "value.darkMax", "max": 0.75, "variant": "sweep", "name": "TK3: dark coverage <= 75 % in every sample of the sweep" },
    { "metric": "value.t3", "equals": true, "variant": ["t45", "sweep"], "name": "truth 3 with the plane tipped: the shader's trace matches the float64 trace (the shifts on both)" },
    { "metric": "value.t9", "equals": "true", "variant": ["t45", "sweep"], "name": "truth 9 with the plane tipped: the song's op log replays (the feed is left out like the triggers)" },
    { "metric": "value.t10", "equals": true, "variant": "t35", "name": "truth 10: canada colours >= 3:1 against the ground, no big drop above L 0.75" },
    { "metric": "fps.p05", "min": 55 },
    { "metric": "longFrames", "max": 0.5 },
    { "metric": "gpuBusy", "max": 10 },
    { "metric": "clip", "max": 1, "name": "no white blobs: <= 1 % pixels clipped" }
  ],
  "record": { "stills": 2 },
  "debug": { "console": true }
}
