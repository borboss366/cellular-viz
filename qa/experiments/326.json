{
  "version": 1,
  "id": "18-little-bang-2",
  "note": "#326 18 Little Bang 2 (the beamline rebuilt with the scene skill, for a blind grade against 18-little-bang.html): first run anywhere. Stills at beat gain 0, 1 and 3 (the beat knob's ends and middle), speed 0 and 1 (the speed knob's ends), no-beat mode (?qaConfidence=0) and the drop (bars 12-15); shared flash, comfort and GPU rows for the default URL, g3 and full speed.",
  "params": { "labels": "0" },
  "resolutions": ["1080p"],
  "warmup": 4,
  "seconds": 8,
  "variants": [
    { "name": "g0", "params": { "beatGain": 0 } },
    { "name": "g1", "params": {} },
    { "name": "g3", "params": { "beatGain": 3 } },
    { "name": "s0", "params": { "speed": 0 } },
    { "name": "s1", "params": { "speed": 1 } },
    { "name": "nobeat", "params": { "qaConfidence": 0 } },
    { "name": "drop", "params": { "startBar": 8.5 } }
  ],
  "shared": { "variants": ["g3", "s1"] },
  "values": {
    "g": "__qa.beat ? __qa.beat.g : -1",
    "ring": "__qa.beat ? __qa.beat.ring : -1",
    "ringNow": "__qa.beat ? __qa.beat.ringNow : -1",
    "rayNow": "__qa.beat ? __qa.beat.rayNow : -1",
    "kicks": "__qa.bang ? __qa.bang.kicksStarted : -1",
    "fromEnergy": "__qa.bang ? __qa.bang.kicksFromEnergy : -1",
    "rayPeaks": "__qa.bang ? __qa.bang.rayPeaks : -1",
    "collisions": "__qa.bang ? __qa.bang.collisions : -1",
    "w": "__qa.bang ? __qa.bang.w : -1",
    "speed": "__qa.bang ? __qa.bang.speed : -1",
    "segments": "__qa.view ? __qa.view.segments : -1",
    "drop": "__qa.view ? (__qa.view.drop ? 1 : 0) : -1",
    "floatTargets": "__qa.view ? (__qa.view.floatTargets ? 1 : 0) : -1"
  },
  "gates": [
    { "metric": "errors", "max": 0 },
    { "metric": "value.g", "equals": 0, "variant": "g0", "name": "?beatGain=0: g 0" },
    { "metric": "value.g", "equals": 1, "variant": ["g1", "s0", "s1", "nobeat", "drop"], "name": "no knob: g 1" },
    { "metric": "value.g", "equals": 3, "variant": "g3", "name": "?beatGain=3: g 3" },
    { "metric": "value.ring", "max": 0, "variant": "g0", "name": "g 0: no light rings" },
    { "metric": "value.ringNow", "max": 0, "variant": "g0", "name": "g 0: no ring drawn" },
    { "metric": "value.rayNow", "max": 0, "variant": "g0", "name": "g 0: a steady ray (no kick)" },
    { "metric": "value.ring", "min": 0.799, "max": 0.801, "variant": "g1", "name": "g 1: ring 0.8 (as designed)" },
    { "metric": "value.ring", "max": 1.6, "name": "the ring never over its cap 1.6" },
    { "metric": "value.ringNow", "max": 1.6, "name": "the ring drawn never over 1.6" },
    { "metric": "value.rayNow", "max": 1.1, "name": "the ray's kick never over +1.1" },
    { "metric": "value.rayPeaks", "max": 6, "name": "the ray pulses at most 3 a second (2 s window)" },
    { "metric": "value.kicks", "min": 8, "variant": ["g0", "g1", "g3", "s0", "s1", "drop"], "name": "the clock's kicks reach the scene" },
    { "metric": "value.collisions", "min": 4, "name": "the bunches cross on the downbeats" },
    { "metric": "value.speed", "max": 0.01, "variant": "s0", "name": "speed knob 0: the camera stands" },
    { "metric": "value.speed", "min": 9.9, "max": 10.01, "variant": "s1", "name": "speed knob 1: 10 tube radii a second" },
    { "metric": "value.speed", "min": 3.5, "max": 3.6, "variant": "g1", "name": "the default speed 0.5 (3.54 R/s)" },
    { "metric": "value.w", "min": 0.95, "variant": "g1", "name": "beat path on the metronome (beat weight 1)" },
    { "metric": "value.w", "max": 0.05, "variant": "nobeat", "name": "?qaConfidence=0: no-beat mode (beat weight 0)" },
    { "metric": "value.fromEnergy", "min": 1, "variant": "nobeat", "name": "no-beat: rings from the heard kick", "report": true },
    { "metric": "value.drop", "equals": 1, "variant": "drop", "name": "?startBar=8.5: the run ends in the drop (bars 12-15)" },
    { "metric": "value.segments", "min": 1, "variant": "g1", "name": "tracks drawn at the far end", "report": true },
    { "metric": "value.floatTargets", "equals": 1, "name": "float render targets (else 8 bits, dithered)", "report": true },
    { "metric": "clip", "max": 1, "name": "at most 1 % clipped pixels" },
    { "metric": "lum.mean", "max": 25, "name": "dark, never empty (mean luminance, % of white)", "report": true },
    { "metric": "lum.min", "min": 2, "name": "never empty: the darkest frame still carries light (% of white)", "report": true }
  ],
  "record": { "stills": 2 },
  "debug": { "console": true }
}
