{
  "version": 1,
  "id": "28-aurora",
  "note": "28 Aurora (the user's brief, 21 Nov 23:00; trial arm A): stills at the default, beat gain 0 and 3, height 0 and 1, colour 0 and 1, no beat (confidence forced to 0), a section change (bars 11-19) and with a second scene (16b Hodge, capture, in a 960x540 frame behind) for the frame time; at 1080p and at the projector window's 960x540.",
  "params": { "labels": "0", "seed": 1 },
  "resolutions": ["1080p", [960, 540]],
  "warmup": 4,
  "seconds": 12,
  "variants": [
    { "name": "default", "params": {} },
    { "name": "g0", "params": { "beatGain": 0 } },
    { "name": "g3", "params": { "beatGain": 3 } },
    { "name": "low", "params": { "height": 0 } },
    { "name": "tall", "params": { "height": 1 } },
    { "name": "green", "params": { "colour": 0 } },
    { "name": "full", "params": { "colour": 1 } },
    { "name": "nobeat", "params": { "qaConf": "0" } },
    { "name": "morph", "params": { "startBar": 11 } },
    { "name": "pair", "params": { "qaCompanion": "16-hodge-kaleidoscope.html" } }
  ],
  "shared": { "variants": ["g3", "tall"] },
  "values": {
    "g": "__qa.aurora ? __qa.aurora.g : -1",
    "w": "__qa.aurora ? __qa.aurora.w : -1",
    "ripples": "__qa.aurora ? __qa.aurora.ripplesFired : -1",
    "drift": "__qa.aurora ? __qa.aurora.driftBars : -1",
    "section": "__qa.aurora ? __qa.aurora.section : -1",
    "height": "__qa.aurora ? __qa.aurora.height : -1",
    "colour": "__qa.aurora ? __qa.aurora.colour : -1",
    "glLost": "__qa.gpu ? __qa.gpu.lost : -1",
    "glRetries": "__qa.gpu ? __qa.gpu.retries : -1",
    "hasForceDrop": "typeof __qa.forceDrop === 'function' ? 1 : 0",
    "companionFrames": "__qa.companion ? __qa.companion.frames : -1",
    "companionErrors": "__qa.companion ? __qa.companion.errors : -1"
  },
  "gates": [
    { "metric": "errors", "max": 0 },
    { "metric": "fps.p05", "min": 55, "resolution": "1080p", "variant": ["default", "g0", "g3", "low", "tall", "green", "full", "nobeat", "morph"], "name": "frame time alone at 1080p (p95 <= 18.2 ms)" },
    { "metric": "fps.p05", "min": 55, "variant": "pair", "report": true, "name": "frame time with a second scene running (16b Hodge in a 960x540 frame)" },
    { "metric": "frameMs.p95", "max": 18.2, "variant": "pair", "report": true, "name": "frame time p95 with a second scene, ms" },
    { "metric": "value.companionFrames", "min": 300, "variant": "pair", "name": "the second scene really ran (its frames)" },
    { "metric": "value.companionErrors", "max": 0, "variant": "pair", "name": "the second scene had no errors" },
    { "metric": "lum.min", "min": 0.05, "name": "never a blank frame" },
    { "metric": "lum.mean", "max": 25, "name": "a night sky, not a bright frame" },
    { "metric": "value.drift", "min": 1, "name": "the folds keep drifting (bars of drift since load)" },
    { "metric": "value.g", "equals": 1, "variant": "default", "name": "no knob: beat gain 1" },
    { "metric": "value.g", "equals": 0, "variant": "g0", "name": "?beatGain=0: g 0" },
    { "metric": "value.g", "equals": 3, "variant": "g3", "name": "?beatGain=3: g 3" },
    { "metric": "value.ripples", "min": 4, "variant": ["default", "g3", "low", "tall", "green", "full", "morph"], "name": "the kicks send ripples" },
    { "metric": "value.ripples", "equals": 0, "variant": "g0", "name": "beat gain 0: no ripple" },
    { "metric": "value.w", "min": 0.95, "variant": "default", "name": "the beat path with the metronome" },
    { "metric": "value.w", "max": 0.05, "variant": "nobeat", "name": "no-beat mode with confidence 0" },
    { "metric": "value.section", "min": 1, "variant": "morph", "name": "the curtains moved on to the next section's shape" },
    { "metric": "clip", "max": 1, "report": true, "name": "bright folds stay under clipping" },
    { "metric": "value.hasForceDrop", "equals": 1, "variant": "default", "name": "#88 __qa.forceDrop() is there" },
    { "metric": "value.glLost", "max": 0, "report": true, "name": "WebGL context lost (a GPU reset; the page rebuilds on restore)" },
    { "metric": "value.glRetries", "max": 0, "report": true, "name": "WebGL2 refused at load, asked again (times)" }
  ],
  "record": { "stills": 2 },
  "debug": { "console": true }
}
