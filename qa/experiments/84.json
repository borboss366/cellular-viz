  "gates": [
    { "metric": "value.tableOk", "equals": true, "name": "QA 1: numbers equal the spec's table (all presets, curve g = 0–6)" },
    { "metric": "value.symmetric", "equals": true, "name": "QA 2: h^{p,q} = h^{q,p} and h^{p,q} = h^{n−p,n−q}" },
    { "metric": "value.bettiOk", "equals": true, "name": "QA 3: row sums = Betti numbers" },
    { "metric": "value.glowErr", "max": 0.01, "name": "QA 4: rendered row glow (linear, L_k = 1) ∝ Betti within 1 %" },
    { "metric": "value.eulerOk", "equals": true, "name": "QA 5: Euler characteristic 2−2g / 24 / −200 / +200" },
    { "metric": "value.holdOk", "equals": true, "name": "QA 6: beats between morph starts = hold at 8, 4, 2, 1, ½ bars, ±1 frame" },
    { "metric": "value.gridOk", "equals": true, "name": "QA 6: changes on the grid (downbeats for holds ≥ 1 bar, beats below)" },
    { "metric": "value.liveHoldErr", "max": 0.000001, "variant": ["auto", "fastest"], "name": "QA 6 live: auto holds on the real clock" },
    { "metric": "value.morphN", "min": 1, "variant": ["auto", "fastest", "trigger-kick"], "name": "QA 7: morphs were logged" },
    { "metric": "value.morphSyncMs", "max": 40, "variant": ["auto", "fastest", "trigger-kick"], "name": "QA 7: each morph ≤ 40 ms from its beat" },
    { "metric": "value.morphOk", "equals": true, "name": "QA 8: morph = min(1 bar, hold/2)" },
    { "metric": "value.triggerOk", "equals": true, "name": "QA 9: trigger() starts the morph on the next beat" },
    { "metric": "value.orderOk", "equals": true, "name": "QA 10: 32 changes, no back-to-back repeat, no two curves adjacent, dimension changes" },
