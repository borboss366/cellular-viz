{
  "version": 1,
  "id": "28-aurora",
  "note": "#305 28 Aurora (skill trial, arm B): first run anywhere. Stills at beat gain 0, 1 and 3 (the beat knob's ends and middle), height 0 and 1, colour 1 (colour 0 is the default), and no-beat mode (?qaConfidence=0); shared flash, comfort and GPU rows for the default URL and g3. General flash is report-only by the user's decision (22 Nov); check-shared still prints it.",
  "params": { "labels": "0" },
  "resolutions": ["1080p"],
  "warmup": 4,
  "seconds": 8,
  "variants": [
    { "name": "g0", "params": { "beatGain": 0 } },
    { "name": "g1", "params": {} },
    { "name": "g3", "params": { "beatGain": 3 } },
    { "name": "h0", "params": { "macro1": 0 } },
    { "name": "h1", "params": { "macro1": 1 } },
    { "name": "c1", "params": { "macro2": 1 } },
    { "name": "nobeat", "params": { "qaConfidence": 0 } }
  ],
  "shared": { "variants": ["g3"] },
  "values": {
    "g": "__qa.beat ? __qa.beat.g : -1",
    "ripple": "__qa.beat ? __qa.beat.ripple : -1",
    "kink": "__qa.beat ? __qa.beat.kink : -1",
    "rippleNow": "__qa.beat ? __qa.beat.now : -1",
    "started": "__qa.aurora ? __qa.aurora.ripplesStarted : -1",
    "fromEnergy": "__qa.aurora ? __qa.aurora.ripplesFromEnergy : -1",
    "w": "__qa.aurora ? __qa.aurora.w : -1",
    "act": "__qa.aurora ? __qa.aurora.act : -1",
    "height": "__qa.aurora ? __qa.aurora.height : -1",
    "colour": "__qa.aurora ? __qa.aurora.colour : -1",
    "layers": "__qa.view ? __qa.view.layers.length : -1",
    "floatTargets": "__qa.view ? (__qa.view.floatTargets ? 1 : 0) : -1"
  },
  "gates": [
    { "metric": "errors", "max": 0 },
    { "metric": "value.layers", "equals": 3, "name": "three curtains drawn" },
    { "metric": "value.g", "equals": 0, "variant": "g0", "name": "?beatGain=0: g 0" },
    { "metric": "value.g", "equals": 1, "variant": ["g1", "h0", "h1", "c1", "nobeat"], "name": "no knob: g 1" },
    { "metric": "value.g", "equals": 3, "variant": "g3", "name": "?beatGain=3: g 3" },
    { "metric": "value.ripple", "max": 0, "variant": "g0", "name": "g 0: no ripple" },
    { "metric": "value.rippleNow", "max": 0, "variant": "g0", "name": "g 0: no ripple drawn" },
    { "metric": "value.ripple", "min": 0.899, "max": 0.901, "variant": "g1", "name": "g 1: ripple 0.9 (as designed)" },
    { "metric": "value.ripple", "max": 1.8, "name": "the ripple never over its cap 1.8" },
    { "metric": "value.rippleNow", "max": 1.8, "name": "the ripple drawn never over 1.8" },
    { "metric": "value.kink", "max": 0.014, "name": "the kink never over 1.4 % of the width" },
    { "metric": "value.started", "min": 8, "variant": ["g0", "g1", "g3", "h0", "h1", "c1"], "name": "the clock's kicks start ripples" },
    { "metric": "value.w", "min": 0.95, "variant": "g1", "name": "beat path on the metronome (beat weight 1)" },
    { "metric": "value.w", "max": 0.05, "variant": "nobeat", "name": "?qaConfidence=0: no-beat mode (beat weight 0)" },
    { "metric": "value.fromEnergy", "min": 1, "variant": "nobeat", "name": "no-beat: ripples from the heard kick", "report": true },
    { "metric": "value.height", "min": 0.41, "max": 0.416, "variant": "g1", "name": "height: the default 0.41" },
    { "metric": "value.height", "min": 0.1599, "max": 0.1601, "variant": "h0", "name": "height knob 0: 0.16" },
    { "metric": "value.height", "min": 0.619, "max": 0.621, "variant": "h1", "name": "height knob 1: 0.62" },
    { "metric": "value.colour", "max": 0, "variant": "g1", "name": "colour knob 0 (default)" },
    { "metric": "value.colour", "min": 0.999, "variant": "c1", "name": "colour knob 1" },
    { "metric": "value.floatTargets", "equals": 1, "name": "float render targets (else 8 bits, dithered)", "report": true },
    { "metric": "clip", "max": 1, "name": "at most 1 % clipped pixels" },
    { "metric": "lum.mean", "max": 20, "name": "mostly dark (mean luminance, % of white)", "report": true }
  ],
  "record": { "stills": 2 },
  "debug": { "console": true }
}
