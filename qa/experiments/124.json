{
  "version": 1,
  "id": "16c-neon-lines",
  "note": "16c 27 Neon Lines (#37 comment 6444942841, 16c): Clebsch cubic ray-cubic film, 27 lasers, 10 Eckardt diamonds, A5 glides (5-cycle on the drop), build-up 3/7/15/27 on 32-bar sections (walls at bars 8, 16, 24 = the drop). Truths 1-6 also run under node (qa/runner/test/clebsch16c.test.mjs). 120 BPM; startBar puts each window on its event.",
  "resolutions": ["1080p", "4k"],
  "warmup": 4,
  "seconds": 12,
  "variants": [
    { "name": "drop", "params": { "variant": "manual", "macro3": "1", "startBar": "20" } },
    { "name": "build", "params": { "variant": "auto", "startBar": "4" } },
    { "name": "climb", "params": { "variant": "auto", "startBar": "12" } },
    { "name": "drop-auto", "params": { "variant": "auto", "startBar": "20" } },
    { "name": "collapse", "params": { "variant": "auto", "startBar": "28" } },
    { "name": "all-finite", "params": { "variant": "manual", "macro3": "1", "chart": "allFinite", "glides": "0" } }
  ],
  "values": {
    "truths": "__qa.check().ok",
    "t1": "__qa.check().t1.ok",
    "t1maxF": "__qa.check().t1.maxF",
    "t2": "__qa.check().t2.ok",
    "t3": "__qa.check().t3.ok",
    "t4": "__qa.check().t4.ok",
    "t5": "__qa.check().t5.ok",
    "glideMaxF": "__qa.check().t5.glideMaxF",
    "t6": "__qa.check().t6.ok",
    "buildCounts": "__qa.check().t6.counts.join(',')",
    "generalPosition": "__qa.check().t6.generalPosition.minTriple",
    "liveMaxRelF": "__qa.live.maxRelF",
    "pairsBad": "__qa.live.pairsBad",
    "pairsChecked": "__qa.live.pairsChecked",
    "lineCountOk": "__qa.live.lineCountOk",
    "counts": "Object.keys(__qa.live.countsSeen).map(Number).sort((a, b) => a - b).join(',')",
    "walls": "__qa.walls.length",
    "glides": "__qa.glides.length",
    "drops": "__qa.drops",
    "lines": "__qa.view.lines",
    "eckardt": "__qa.view.eckardt",
    "diamondsOnScreen": "__qa.view.diamondsOnScreen",
    "peaks": "__qa.peaks",
    "laserEnergy": "__qa.metrics.laserEnergy",
    "forceDrop": "typeof __qa.forceDrop"
  },
  "gates": [
    { "metric": "value.t1", "equals": true, "variant": "drop", "name": "QA 1: the 27 table lines lie on F (max |F| < 1e-9, float64)" },
    { "metric": "value.t2", "equals": true, "variant": "drop", "name": "QA 2: 135 meeting pairs (126 affine + 9 at infinity), each line meets 10" },
    { "metric": "value.t3", "equals": true, "variant": "drop", "name": "QA 3: 10 Eckardt points (7 finite + 3 directions)" },
    { "metric": "value.t4", "equals": true, "variant": "drop", "name": "QA 4: M maps the P4 model onto F = 0; e_i - e_j go to the Eckardt points" },
    { "metric": "value.t5", "equals": true, "variant": "drop", "name": "QA 5: S5 permutes lines and diamonds, orbits {15,12} and {10}; A5 glides keep |F_s| < 1e-9" },
    { "metric": "value.t6", "equals": true, "variant": "drop", "name": "QA 6: build-up 3/7/15/27 lines, 3/9/45/135 meetings, 10 Eckardt at the end" },
    { "metric": "value.liveMaxRelF", "max": 1e-8, "name": "every drawn laser lies on the drawn surface (relative |F|, every frame)" },
    { "metric": "value.pairsBad", "max": 0, "name": "meetings match the line count on every frame away from the walls" },
    { "metric": "value.lineCountOk", "equals": true, "name": "real line count = r + C(r,2) + c + r on every frame" },
    { "metric": "value.counts", "equals": "27", "variant": ["drop", "all-finite"], "name": "27 lines all the way" },
    { "metric": "value.counts", "equals": "3,7", "variant": "build", "name": "bar 8: 3 -> 7" },
    { "metric": "value.counts", "equals": "7,15", "variant": "climb", "name": "bar 16: 7 -> 15" },
    { "metric": "value.counts", "equals": "15,27", "variant": "drop-auto", "name": "bar 24 (the drop): 15 -> 27" },
    { "metric": "value.counts", "equals": "3,7,15,27", "variant": "collapse", "name": "bar 31: 27 -> 15 -> 7 -> 3" },
    { "metric": "value.walls", "min": 1, "variant": ["build", "climb", "drop-auto"], "name": "a wall crossed (gold flash)" },
    { "metric": "value.walls", "min": 3, "variant": "collapse", "name": "three walls crossed back" },
    { "metric": "value.drops", "min": 1, "variant": ["drop", "drop-auto"], "name": "the drop fired (5-cycle glide)" },
    { "metric": "value.glides", "min": 8, "variant": "drop", "name": "shape rate 1/2 bar: a glide every 2 beats" },
    { "metric": "value.glides", "max": 0, "variant": "all-finite", "name": "glides=0 stands still" },
    { "metric": "value.eckardt", "equals": 10, "variant": ["drop", "all-finite"], "name": "10 diamonds" },
    { "metric": "value.diamondsOnScreen", "equals": 10, "variant": "all-finite", "name": "chart allFinite: all 10 diamonds in view" },
    { "metric": "value.forceDrop", "equals": "function", "name": "#88 forceDrop hook" },
    { "metric": "fps.p05", "min": 55 },
    { "metric": "longFrames", "max": 0.5 },
    { "metric": "errors", "max": 0 },
    { "metric": "gpuBusy", "max": 10 },
    { "metric": "clip", "max": 1, "name": "no white blobs: <= 1 % pixels clipped" }
  ],
  "record": { "stills": 2 },
  "debug": { "console": true, "screenshotAt": [2, 8] }
}
