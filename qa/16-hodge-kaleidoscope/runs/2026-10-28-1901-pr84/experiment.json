{
  "version": 1,
  "id": "16-hodge-kaleidoscope",
  "note": "16b Hodge Kaleidoscope (spec #37 comment 6444942841): the Hodge diamond as kaleidoscope cell. Truths: numbers = spec table, Hodge symmetry + Serre duality, row sums = Betti, Euler, rendered row glow ∝ Betti within 1 %.",
  "resolutions": ["1080p", "4k"],
  "warmup": 4,
  "seconds": 12,
  "variants": [
    { "name": "auto", "params": {} },
    { "name": "k3-flat", "params": { "preset": "k3", "bands": "flat" } },
    { "name": "quintic-flat", "params": { "preset": "quintic", "bands": "flat" } },
    { "name": "curve3-flat", "params": { "preset": "curve", "genus": 3, "bands": "flat" } }
  ],
  "values": {
    "tableOk": "__qa.check().tableOk",
    "symmetric": "__qa.check().symmetric",
    "bettiOk": "__qa.check().bettiOk",
    "eulerOk": "__qa.check().eulerOk",
    "glowErr": "__qa.measureRowGlow().maxRelErr",
    "preset": "__qa.preset"
  },
  "gates": [
    { "metric": "value.tableOk", "equals": true, "name": "QA 1: numbers equal the spec's table (all presets, curve g = 0–6)" },
    { "metric": "value.symmetric", "equals": true, "name": "QA 2: h^{p,q} = h^{q,p} and h^{p,q} = h^{n−p,n−q}" },
    { "metric": "value.bettiOk", "equals": true, "name": "QA 3: row sums = Betti numbers" },
    { "metric": "value.glowErr", "max": 0.01, "name": "QA 4: rendered row glow (linear, L_k = 1) ∝ Betti within 1 %" },
    { "metric": "value.eulerOk", "equals": true, "name": "QA 5: Euler characteristic 2−2g / 24 / −200 / +200" },
    { "metric": "fps.p05", "min": 55 },
    { "metric": "longFrames", "max": 0.5 },
    { "metric": "errors", "max": 0 },
    { "metric": "gpuBusy", "max": 10 },
    { "metric": "clip", "max": 1, "name": "no white blobs: ≤ 1 % pixels clipped" }
  ],
  "record": { "stills": 2 },
  "swipe": { "seconds": 40, "warmup": 4, "variants": ["auto"] },
  "debug": { "console": true, "screenshotAt": [2, 8] }
}
