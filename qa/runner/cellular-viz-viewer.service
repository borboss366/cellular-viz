# systemd user unit for the QA viewer at :8787. Install on the box itself (the host), once, as the normal user (no sudo):
#   cp /home/puggie/pi-durable-worker/data/cellular-viz-runner/qa/runner/cellular-viz-viewer.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now cellular-viz-viewer
# The unit holds no logic: it only starts and stops the fixed script qa/runner/viewer.sh from RUNNER_HOME (main's clone)
# inside Puggie's container, so every change arrives with qa/update-runner.sh and this file never changes.
# viewer.sh runs main's qa/serve.mjs on QA box's data (QA_HOME). update-runner.sh restarts it (kill -TERM; back in 5 s).
# It uses the runner's env file (CONTAINER, RUNNER_HOME, RUNNER_STATE, QA_HOME, RUNNER_SOCKET).
# No port is opened here: the viewer listens on a Unix socket in the bind-mounted data folder, and the host's existing
# systemd-socket-proxyd units forward :8787 to it. No systemd sandboxing: the process is a podman exec into the already
# confined rootless container, and NoNewPrivileges/namespacing can break rootless podman's setuid helpers.
[Unit]
Description=cellular-viz QA viewer (:8787 builds, runs, swipe grading)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%h/.config/cellular-viz-runner.env
ExecStart=/usr/bin/podman exec --env-file %h/.config/cellular-viz-runner.env ${CONTAINER} sh ${RUNNER_HOME}/qa/runner/viewer.sh
ExecStop=/usr/bin/podman exec --env-file %h/.config/cellular-viz-runner.env ${CONTAINER} sh ${RUNNER_HOME}/qa/runner/viewer.sh stop
SuccessExitStatus=1 143 SIGTERM
TimeoutStopSec=20
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
