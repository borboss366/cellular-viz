# ~/.config/cellular-viz-runner.env on the box. Paths without a _HOST suffix are as seen inside the container.

# Puggie's worker container (podman ps)
CONTAINER=pi-durable-worker

# QA box's working copy: qa/builds.mjs, qa/builds.json, qa/node_modules, the check results the viewer shows
QA_HOME=/path/inside/container/to/cellular-viz

# a clean clone of main, only for the runner code (git -C ... pull to update it)
RUNNER_HOME=/path/inside/container/to/cellular-viz-runner

# where the check scripts come from: never the PR. QA box's branch until #20 is merged, then main
CHECKS_REF=qa/headless-runner

# only PRs from these GitHub accounts (forks never run)
RUNNER_AUTHORS=borboss366

# seconds between polls of the open PR list (anonymous API: 60 requests an hour; unchanged lists are free)
RUNNER_POLL=120

# minutes before a check is stopped
RUNNER_TIMEOUT_MIN=90

# runner state: the work clone, state.json, runner.log, runner.pid
RUNNER_STATE=/path/inside/container/to/.cache/cellular-viz-runner

# the read-only API: a Unix socket in the bind-mounted folder (inside path), and the same file seen from the host
RUNNER_SOCKET=/path/inside/container/to/data/qa-runner.sock
RUNNER_SOCKET_HOST=/home/puggie/pi-durable-worker/data/qa-runner.sock
